<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="sterilization_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    
    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- Outer Boundaries -->
        <collision name="top"><pose>0 3 1 0 0 0</pose><geometry><box><size>8 0.2 2</size></box></geometry></collision>
        <visual name="top_v"><pose>0 3 1 0 0 0</pose><geometry><box><size>8 0.2 2</size></box></geometry></visual>
        <collision name="bottom"><pose>0 -3 1 0 0 0</pose><geometry><box><size>8 0.2 2</size></box></geometry></collision>
        <visual name="bottom_v"><pose>0 -3 1 0 0 0</pose><geometry><box><size>8 0.2 2</size></box></geometry></visual>
        <collision name="left"><pose>-4 0 1 0 0 0</pose><geometry><box><size>0.2 6 2</size></box></geometry></collision>
        <visual name="left_v"><pose>-4 0 1 0 0 0</pose><geometry><box><size>0.2 6 2</size></box></geometry></visual>
        <collision name="right"><pose>4 0 1 0 0 0</pose><geometry><box><size>0.2 6 2</size></box></geometry></collision>
        <visual name="right_v"><pose>4 0 1 0 0 0</pose><geometry><box><size>0.2 6 2</size></box></geometry></visual>
        
        <!-- Dividing Wall (leaves a 1.5m doorway at the top) -->
        <collision name="divider"><pose>0 -1 1 0 0 0</pose><geometry><box><size>0.2 4 2</size></box></geometry></collision>
        <visual name="divider_v"><pose>0 -1 1 0 0 0</pose><geometry><box><size>0.2 4 2</size></box></geometry></visual>
      </link>
    </model>

    <!-- Minimal Furniture -->
    <model name="table1">
      <static>true</static>
      <pose>-2 -1 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>
    
    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>2 1 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1</length></cylinder></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
